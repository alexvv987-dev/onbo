# Все профили, инструкции и корпоративные сервисы в MVP синтетические.
# demo явно использует детерминированные ответы; для настоящей модели задайте gigachat.
LLM_MODE=demo
DEMO_MODE=true
POSTGRES_PASSWORD=onbo-demo-local
MOCK_TOKEN=local-demo-service-token

# Настоящий GigaChat API для физлица. Ключ вводится только локально.
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_MODEL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# PEM-файл с доверенными CA, см. README (путь внутри контейнера).
GIGACHAT_CA_FILE=

# Необязательные overrides YAML (раскомментируйте нужные строки).
# CONFIG_FILE=configs/onbo.yaml
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_IDLE_TIMEOUT=60s
# INIT_TIMEOUT=15s
# SHUTDOWN_TIMEOUT=10s
# REDIS_DIAL_TIMEOUT=3s
# REDIS_READ_TIMEOUT=3s
# REDIS_WRITE_TIMEOUT=3s
# SESSION_TTL=12h
# CHAT_RATE_WINDOW=60s
# CHAT_RATE_LIMIT=20
# MOCK_TIMEOUT=4s
# HEALTH_TIMEOUT=2s
# CHAT_TIMEOUT=45s
# MAX_REQUEST_BYTES=32768
# GIGACHAT_REQUEST_TIMEOUT=45s
# GIGACHAT_REPLY_TIMEOUT=90s
